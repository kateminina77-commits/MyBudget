<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F4F8F5">

    <FrameLayout
        android:id="@+id/splashIcon"
        android:layout_width="104dp"
        android:layout_height="104dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="MoneyMe logo"
            android:src="@drawable/mybudget_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="₪"
            android:textColor="#173F35"
            android:textSize="34sp"
            android:textStyle="bold" />

    </FrameLayout>

    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="MoneyMe"
        android:textColor="#173F35"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Take control of your money"
        android:textColor="#60756D"
        android:textSize="16sp" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginTop="36dp"
        android:indeterminate="true"
        android:indeterminateTint="#2E8B68" />

</LinearLayout>